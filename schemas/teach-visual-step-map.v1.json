{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study-os.local/schemas/teach-visual-step-map.v1.json",
  "title": "Study-os lesson\u00d7step \u2192 visual type catalog",
  "type": "object",
  "required": [
    "schema_version",
    "entries"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "study-os.teach-visual-step-map.v1"
    },
    "updated": {
      "type": "string"
    },
    "issue": {
      "type": "string"
    },
    "parent_issue": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lesson_id",
          "step_id",
          "visual_type",
          "status"
        ],
        "properties": {
          "lesson_id": {
            "type": "string"
          },
          "step_id": {
            "type": "string"
          },
          "kc": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visual_type": {
            "type": "string"
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "landed",
              "queued",
              "blocked"
            ]
          },
          "research_cites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "queue_issue": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
