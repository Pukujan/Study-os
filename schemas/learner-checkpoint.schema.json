{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study-os.local/schemas/learner-checkpoint.schema.json",
  "title": "Study OS Learner Checkpoint",
  "type": "object",
  "required": [
    "schema_version",
    "checkpoint_id",
    "subject_id",
    "created_at",
    "source_sessions",
    "scope",
    "state",
    "resume"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "checkpoint_id": {"type": "string"},
    "subject_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "learner_model_version": {"type": ["string", "null"]},
    "source_sessions": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "source_episode_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "source_event_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "scope": {
      "type": "object",
      "required": ["domain", "concepts"],
      "properties": {
        "domain": {"type": "string"},
        "concepts": {"type": "array", "items": {"type": "string"}},
        "language": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["skills", "representation_history", "open_hypotheses", "assistance"],
      "properties": {
        "skills": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["status", "evidence"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["not_tested", "fail", "partial", "pass_supported", "pass_unaided", "pass_transfer", "pass_delayed"]
              },
              "evidence": {"type": "array", "items": {"type": "string"}},
              "notes": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        },
        "representation_history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["representation_id", "outcome"],
            "properties": {
              "representation_id": {"type": "string"},
              "operation": {"type": ["string", "null"]},
              "outcome": {"type": "string", "enum": ["worse", "no_change", "partial", "helped", "not_tested"]},
              "self_report_event_id": {"type": ["string", "null"]},
              "behavior_event_ids": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "open_hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hypothesis", "confidence", "evidence"],
            "properties": {
              "hypothesis": {"type": "string"},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "evidence": {"type": "array", "items": {"type": "string"}},
              "next_probe": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        },
        "assistance": {
          "type": "object",
          "required": ["current_level"],
          "properties": {
            "current_level": {"type": "string"},
            "last_successful_level": {"type": ["string", "null"]},
            "next_fade_target": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "learner_notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "evidence_event_id"],
            "properties": {
              "text": {"type": "string"},
              "evidence_event_id": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "resume": {
      "type": "object",
      "required": ["current_focus", "do_not_reteach", "next_action", "checkpoint_reason"],
      "properties": {
        "current_focus": {"type": "string"},
        "do_not_reteach": {"type": "array", "items": {"type": "string"}},
        "next_action": {"type": "string"},
        "next_probe": {"type": ["string", "null"]},
        "retention_due_at": {"type": ["string", "null"], "format": "date-time"},
        "checkpoint_reason": {"type": "string", "enum": ["session_end", "lesson_boundary", "breakthrough", "failure", "manual", "pre_transfer", "post_transfer", "pre_delay", "post_delay"]}
      },
      "additionalProperties": false
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
