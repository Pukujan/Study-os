{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study.design-bakery.com/schemas/teach-visual-provenance.v1.json",
  "title": "study-os.teach-visual-provenance.v1",
  "type": "object",
  "required": ["schema_version", "pack_id", "assets"],
  "properties": {
    "schema_version": { "const": "study-os.teach-visual-provenance.v1" },
    "pack_id": { "type": "string" },
    "updated": { "type": "string" },
    "policy": { "type": "object" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "path", "public_src", "sha256", "source"],
        "properties": {
          "asset_id": { "type": "string" },
          "path": { "type": "string" },
          "public_src": { "type": "string" },
          "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
          "source": {
            "type": "object",
            "required": ["page", "license"],
            "properties": {
              "page": { "type": "string" },
              "license": { "type": "string" },
              "author": { "type": "string" },
              "license_url": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
