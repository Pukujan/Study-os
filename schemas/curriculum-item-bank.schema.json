{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study-os.local/schemas/curriculum-item-bank.schema.json",
  "title": "Study OS Curriculum Item Bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["bank_version", "domain_id", "slice_id", "graph_version", "items"],
  "properties": {
    "bank_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "domain_id": {"type": "string", "minLength": 1},
    "slice_id": {"type": "string", "minLength": 1},
    "graph_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "version", "title", "task_mode", "primary_competency_id", "competency_ids",
          "exposure_class", "assistance_ceiling", "learning_operation", "representation_families",
          "complexity", "grader", "prompt", "expected_evidence"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "title": {"type": "string", "minLength": 1},
          "task_mode": {
            "enum": [
              "manual_code_blank", "manual_code_scaffolded", "phone_shorthand", "verbal_explanation",
              "state_prediction", "code_trace", "code_reading", "parsons_completion",
              "debug_existing_code", "ai_oversight_review"
            ]
          },
          "primary_competency_id": {"type": "string", "minLength": 1},
          "competency_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "exposure_class": {"enum": ["practice", "diagnostic", "transfer_public_fixture", "retention_public_fixture"]},
          "assistance_ceiling": {"enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"]},
          "learning_operation": {"enum": ["trace", "predict", "explain", "contrast", "reconstruct", "debug", "translate", "transfer", "retain"]},
          "representation_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "complexity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prerequisite_depth", "state_variables", "control_flow", "syntax_load", "representation_translation", "surface_novelty", "scaffold_amount", "transfer_distance"],
            "properties": {
              "prerequisite_depth": {"type": "integer", "minimum": 0, "maximum": 5},
              "state_variables": {"type": "integer", "minimum": 0, "maximum": 5},
              "control_flow": {"type": "integer", "minimum": 0, "maximum": 5},
              "syntax_load": {"type": "integer", "minimum": 0, "maximum": 5},
              "representation_translation": {"type": "integer", "minimum": 0, "maximum": 5},
              "surface_novelty": {"type": "integer", "minimum": 0, "maximum": 5},
              "scaffold_amount": {"type": "integer", "minimum": 0, "maximum": 5},
              "transfer_distance": {"type": "integer", "minimum": 0, "maximum": 5}
            }
          },
          "grader": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "reference"],
            "properties": {
              "type": {"enum": ["exact_state", "manual_rubric", "python_tests", "parsons_order"]},
              "reference": {"type": "string", "minLength": 1}
            }
          },
          "prompt": {"type": "string", "minLength": 1},
          "expected_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
