{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study-os.local/schemas/competency-graph.schema.json",
  "title": "Study OS Atomic Competency Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph_version", "domain_id", "slice_id", "competencies"],
  "properties": {
    "graph_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "domain_id": {"type": "string", "minLength": 1},
    "slice_id": {"type": "string", "minLength": 1},
    "competencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "title",
          "observable_behavior",
          "prerequisites",
          "task_modes",
          "misconceptions",
          "transfer_targets"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "title": {"type": "string", "minLength": 1},
          "observable_behavior": {"type": "string", "minLength": 1},
          "prerequisites": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "task_modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "manual_code_blank",
                "manual_code_scaffolded",
                "phone_shorthand",
                "verbal_explanation",
                "state_prediction",
                "code_trace",
                "code_reading",
                "parsons_completion",
                "debug_existing_code",
                "ai_oversight_review"
              ]
            }
          },
          "misconceptions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "description", "evidence_signals"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1},
                "evidence_signals": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          },
          "transfer_targets": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
