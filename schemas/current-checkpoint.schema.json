{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study-os.local/schemas/current-checkpoint.schema.json",
  "title": "Study OS Current Checkpoint Pointer",
  "type": "object",
  "required": ["schema_version", "subject_id", "status", "updated_at", "next_action"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject_id": {"type": "string"},
    "status": {"type": "string", "enum": ["not_started", "active", "paused", "retention_due", "completed"]},
    "updated_at": {"type": "string", "format": "date-time"},
    "checkpoint_id": {"type": ["string", "null"]},
    "checkpoint_path": {"type": ["string", "null"]},
    "current_focus": {"type": ["string", "null"]},
    "next_action": {"type": "string"},
    "retention_due_at": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
