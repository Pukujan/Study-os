{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study-os.local/schemas/learning-episode.schema.json",
  "title": "Study OS Learning Episode",
  "type": "object",
  "required": [
    "schema_version",
    "episode_id",
    "session_id",
    "subject_id",
    "concept",
    "event_ids",
    "status"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "episode_id": {"type": "string"},
    "session_id": {"type": "string"},
    "subject_id": {"type": "string"},
    "domain": {"type": "string"},
    "concept": {"type": "string"},
    "lesson_id": {"type": ["string", "null"]},
    "problem_id": {"type": ["string", "null"]},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"type": "string", "enum": ["open", "closed", "needs_review"]},
    "event_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "transition_target": {
      "type": ["object", "null"],
      "properties": {
        "from": {"type": ["string", "null"]},
        "to": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "failure": {
      "type": ["object", "null"],
      "properties": {
        "observed": {"type": ["boolean", "null"]},
        "type": {"type": ["string", "null"]},
        "evidence_event_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id"],
        "properties": {
          "event_id": {"type": "string"},
          "representation_id": {"type": ["string", "null"]},
          "operation": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "outcomes": {
      "type": "object",
      "properties": {
        "immediate": {"type": ["string", "null"], "enum": ["pass", "fail", "partial", "not_tested", null]},
        "assistance_removed": {"type": ["string", "null"], "enum": ["pass", "fail", "partial", "not_tested", null]},
        "transfer": {"type": ["string", "null"], "enum": ["pass", "fail", "partial", "not_tested", null]},
        "retention": {"type": ["string", "null"], "enum": ["pass", "fail", "partial", "not_tested", null]}
      },
      "additionalProperties": false
    },
    "self_report_summary": {"type": ["string", "null"]},
    "derived_interpretation": {"type": ["string", "null"]},
    "review": {
      "type": "object",
      "properties": {
        "subject_confirmed": {"type": ["boolean", "null"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
