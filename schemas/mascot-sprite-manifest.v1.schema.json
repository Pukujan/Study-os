{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study-os.local/schemas/mascot-sprite-manifest.v1.schema.json",
  "title": "Study OS mascot sprite manifest (SOS-0014)",
  "description": "Manifest for web/public/mascot sprite sheets: frame grid metadata, checksums, per-frame non-empty rule, and CGM provenance. Written by tools/generate_mascot_frames.py; consumed by web/src/mascot/Pet.tsx.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "character", "sheets"],
  "properties": {
    "schema_version": { "const": "study-os.mascot-sprite-manifest.v1" },
    "character": { "type": "string", "enum": ["learner", "helper", "duo"] },
    "system_version": { "type": "string" },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["animation", "file", "frames", "frame_w", "frame_h", "rows", "cols", "fps", "loop", "sha256", "empty_frame_check", "provenance"],
        "properties": {
          "animation": { "type": "string", "enum": ["idle", "walk", "walk_turn", "turn", "wave", "thinking", "talking", "celebrate", "encourage", "hover", "headpat", "starplay"] },
          "file": { "type": "string", "pattern": "^/mascot/[a-z0-9-]+\\.webp$" },
          "frames": { "type": "integer", "minimum": 1, "maximum": 64 },
          "frame_w": { "type": "integer", "minimum": 8 },
          "frame_h": { "type": "integer", "minimum": 8 },
          "rows": { "type": "integer", "minimum": 1 },
          "cols": { "type": "integer", "minimum": 1 },
          "fps": { "type": "integer", "minimum": 1, "maximum": 24, "default": 8 },
          "loop": { "type": "boolean" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "empty_frame_check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min_opaque_pixels", "alpha_threshold"],
            "properties": {
              "min_opaque_pixels": { "type": "integer", "minimum": 1 },
              "alpha_threshold": { "type": "integer", "minimum": 1, "maximum": 255, "default": 16 }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "generated_at"],
            "properties": {
              "source": { "type": "string", "enum": ["cgm", "sprites_py_postprocess", "hand_authored"] },
              "model": { "type": ["string", "null"], "maxLength": 120 },
              "provider": { "type": ["string", "null"], "maxLength": 60 },
              "prompt_file": { "type": ["string", "null"], "pattern": "^\\.content-system/characters/prompts/.+" },
              "prompt_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
              "reference_paths": { "type": "array", "items": { "type": "string", "pattern": "^\\.content-system/characters/refs/.+" } },
              "reference_sha256": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
              "source_sheet_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
              "generated_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}
