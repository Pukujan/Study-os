{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study-os.local/schemas/p4-diagnosis-proposal.schema.json",
  "title": "Study OS P4 Diagnosis Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_version",
    "model_adapter",
    "source_evidence_ids",
    "hypotheses",
    "representation_signals"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "prompt_version": {
      "const": "p4-diagnosis-proposal.v0.1"
    },
    "model_adapter": {
      "type": "string",
      "minLength": 1
    },
    "source_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "representation_signals": {
      "$ref": "#/$defs/representationSignals"
    }
  },
  "$defs": {
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosis_id",
        "family",
        "source_evidence_ids",
        "suspected_competency_ids",
        "confidence",
        "status"
      ],
      "properties": {
        "diagnosis_id": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "enum": [
            "missing_prerequisite",
            "concept_failure",
            "representation_interference",
            "identifier_interference",
            "information_overload",
            "information_underload",
            "decomposition_too_coarse",
            "over_decomposition",
            "over_help",
            "uncertain_mixed"
          ]
        },
        "source_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "suspected_competency_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": ["proposed", "supported", "contradicted", "unresolved"]
        }
      }
    },
    "representationSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_families",
        "avoid_families",
        "code_visibility",
        "interaction_granularity"
      ],
      "properties": {
        "requested_families": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "avoid_families": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "code_visibility": {
          "enum": ["unspecified", "hide_initially", "allow", "require"]
        },
        "interaction_granularity": {
          "enum": ["unspecified", "single_probe", "multi_part"]
        }
      }
    }
  }
}
