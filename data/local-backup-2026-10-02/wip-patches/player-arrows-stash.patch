+    def test_teach_content_does_not_duplicate_or_spoil_the_probe(self):
+        from study_os.web.player import engine
+
+        for lid, lesson in self._load_lessons():
+            for step in lesson["steps"]:
+                probe = step.get("probe")
+                if not probe:
+                    continue
+                step_id = step["step_id"]
+                teach = step.get("teach") or {}
+                prompt = (probe.get("prompt_md") or "").strip()
+                accepted = [str(a) for a in probe.get("accept", [])]
+
+                # The teach card must explain the concept, not restate the
+                # probe's question.
+                self.assertNotEqual(
+                    (teach.get("md") or "").strip(),
+                    prompt,
+                    f"{lid}/{step_id}: teach.md duplicates the probe prompt",
+                )
+
+                teach_texts = [teach.get("md") or ""]
+                for frame in teach.get("frames") or []:
+                    teach_texts.append(frame.get("caption") or "")
+
+                # The teach card must not state the probe's accepted answer.
+                for text in teach_texts:
+                    for answer in accepted:
+                        self.assertNotIn(
+                            answer,
+                            text,
+                            f"{lid}/{step_id}: teach text {text!r} spoils answer {answer!r}",
