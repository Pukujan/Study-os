# /srv/study-os/.env  (chmod 600, never commit the real file)
POSTGRES_PASSWORD=change-me-long-random
SERVER_SECRET=change-me-long-random
PUBLIC_BASE_URL=https://study.design-bakery.com
ALLOWED_ORIGINS=https://study.design-bakery.com
COOKIE_SECURE=1
API_HOST_PORT=18400
# Cloudflare named tunnel token (created via the Cloudflare API; see deploy/README.md)
TUNNEL_TOKEN=
# Decision model (OpenRouter hosted Jev, pinned typesafe/jev-1.13) and frontier LLM (InferHub)
OPENROUTER_API_KEY=
INFERHUB_API_KEY=
# Google sign-in: add both to enable the Google button (redirect URI:
# https://study.design-bakery.com/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Caps (USD / calls per day)
GLOBAL_DAILY_SPEND_USD=3
LLM_SPEND_CAP_USD=5
USER_DAILY_MODEL_CALLS=400
