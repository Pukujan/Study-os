# Study OS raw learning evidence may contain private/sensitive conversation data.
# Keep canonical raw transcripts in a local/private evidence store by default.
sessions/**/raw/*
!sessions/**/raw/.gitkeep

# Local/private evidence root if used.
.study-os-private/

# Common local artifacts
artifacts/
__pycache__/
*.pyc
.venv/
.env
.env.*

# PCM managed task worktrees (pcm/worktree/<TASK-ID>) are local-only.
pcm/worktree/

# Build/test artifacts
build/
dist/
*.egg-info/
.coverage
web/node_modules/
web/dist/
# SOS-0017/SOS-0018 gate run outputs: a committed receipt or screenshot would be
# fabricated evidence, so these are never tracked.
web/e2e/.artifacts/
web/playwright-report/
evals/out/
!.env.example
*.tsbuildinfo
